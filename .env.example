# ---------------------------------------------------------------------------
# OAT agent-infrastructure backend — environment variables
# Copy to .env (never commit .env). Empty values are treated as unset.
# The server loads ./.env automatically if present; real env vars take precedence.
# ---------------------------------------------------------------------------

# ===== Server =====
# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false

# ===== Gateway =====
# Comma-separated exact origins allowed to call the API from a browser. "*" is rejected. Empty = CORS disabled.
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT_BYTES=1048576
# Requests per window, keyed by bearer token (or client IP when unauthenticated).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Execution starts per window per token.
EXECUTION_RATE_LIMIT_MAX=20

# ===== Storage =====
# SQLite database file; created and migrated on start.
DATABASE_PATH=./data/oat.db

# ===== Auth =====
# REQUIRED in production. Comma-separated "userId:role:sha256(token)", role = admin | user.
# Generate an entry with:  npm run token:create -- alice admin
AUTH_TOKENS=
# Development only: with no AUTH_TOKENS set, unauthenticated requests act as an admin "dev" user.
# Rejected when NODE_ENV=production.
AUTH_DEV_BYPASS=false
# Capabilities that non-admin users may use in workflows.
USER_ALLOWED_CAPABILITIES=llm.generate,text.embed,text.rerank,web.search,web.extract,github.repo

# ===== Provider manager =====
# Per-attempt timeout.
PROVIDER_TIMEOUT_MS=30000
# Per-attempt timeout for AI text generation, which takes far longer than other calls.
LLM_TIMEOUT_MS=120000
# Retries for timeouts, 429s, 5xx and network errors (exponential backoff + jitter, honours Retry-After).
PROVIDER_MAX_RETRIES=2
# Fallback happens only between providers of a fallback-compatible capability (web.search, web.extract, text.rerank).
PROVIDER_FALLBACK_ENABLED=true
# Optional, STRICT: restrict a capability to these providers, in this order. A routed provider that is
# not configured makes the capability unavailable (with a reason) — no other provider or mock is used.
# Comma-separated, e.g. llm.generate=gemini,web.search=tavily|exa
PROVIDER_ROUTING=
# Development/testing only: deterministic fake data labelled [MOCK]. Rejected in production.
ENABLE_MOCK_PROVIDERS=false

# ===== Orchestration =====
MAX_CONCURRENT_EXECUTIONS=4
EXECUTION_TIMEOUT_MS=300000
MAX_STORED_OUTPUT_BYTES=262144

# ===== SSRF policy (web.extract) =====
# Optional allowlist of hosts/parent domains. Empty = any public host.
SSRF_ALLOWED_HOSTS=
# Optional extra denylist (private/reserved ranges are always blocked).
SSRF_BLOCKED_HOSTS=

# ===== Providers — all OPTIONAL; each stays disabled until configured =====
# Anthropic Claude -> llm.generate
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000

# Google Gemini -> llm.generate (free tier available)
# Get a key at https://aistudio.google.com/apikey ("Create API key"). Server-side only.
# Free-tier models are listed at https://ai.google.dev/gemini-api/docs/pricing; on the free tier
# Google may use prompts and responses to improve its products. Limits are shown in AI Studio.
# Default gemini-3.6-flash (stable). Newer models can return 503 "high demand" while capacity ramps up.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=8192

# Jina AI -> text.embed, text.rerank, web.extract (Reader)
JINA_API_KEY=
# true enables web.extract via Reader without a key (low per-IP rate limit).
JINA_READER_KEYLESS=false
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_RERANK_MODEL=jina-reranker-v3

# Tavily -> web.search (primary). Key from https://app.tavily.com (sent as Authorization: Bearer).
# Fallback to Exa happens automatically when EXA_API_KEY is also set.
TAVILY_API_KEY=
# Exa -> web.search (compatible fallback)
EXA_API_KEY=
# GitHub REST, read-only -> github.repo
GITHUB_TOKEN=
