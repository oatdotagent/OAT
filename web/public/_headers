# Cloudflare Pages response headers (copied into web/dist by Vite).
# The icon sprite and favicon are not content-hashed, so browsers must revalidate them
# instead of caching for hours; otherwise newly added icons render blank until the cache expires.
/icons.svg
  Cache-Control: no-cache
/favicon.svg
  Cache-Control: no-cache
# Security headers for the static site (mirrors the backend's helmet policy).
/*
  Strict-Transport-Security: max-age=2592000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
