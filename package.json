{
  "name": "getoat",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent infrastructure backend: API gateway, provider manager, workflow orchestration, verification, observability.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "main": "dist/server.js",
  "bin": {
    "getoat": "dist/cli/index.js"
  },
  "files": [
    "dist/**/*.js",
    "web/dist"
  ],
  "scripts": {
    "prepack": "npm run build",
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/server.js",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx e2e/run.ts",
    "migrate": "tsx src/storage/migrate-cli.ts",
    "token:create": "tsx scripts/create-token.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
